# Simulation settings. The physical robot uses .env.real (justfile.jazzy).

# =======================================
# Hardware config
# =======================================

# Select wheel type:
# - True - mecanum wheels
# - False - regular
MECANUM=True

# =======================================
# SLAM / Nav2 config
# =======================================

# Select SLAM mode (to load map place the `map.yaml` and `map.png` file in the `./maps` path):
# - True - with mapping
# - False - without mapping
SLAM=False

# Map loaded by Nav2 when SLAM=False (file name inside ./maps).
# map_u.yaml matches worlds/custom_world_u.sdf; map.yaml matches custom_world_3.sdf.
MAP_YAML=map_u.yaml

# Period of time for autosave map. Work only when SLAM=True (set 0 to disable)
SAVE_MAP_PERIOD=15

# Select controller:
# - dwb - DWB controller
# - rpp - Regulated Pure Pursuit
# - mppi - Model Predictive Path Integral
CONTROLLER=rpp
